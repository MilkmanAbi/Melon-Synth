{
  "compilerOptions": {
    "target":           "ES2020",
    "module":           "commonjs",
    "lib":              ["ES2020"],
    "outDir":           "./electron",
    "strict":           true,
    "esModuleInterop":  true,
    "skipLibCheck":     true,
    "resolveJsonModule": true,
    "sourceMap":        true,
    "moduleResolution": "node"
  },
  "include": [
    "electron-src/**/*",
    "src/engine/mlc-bridge.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
