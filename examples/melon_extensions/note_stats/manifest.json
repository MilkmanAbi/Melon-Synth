{
  "id":            "note_stats",
  "name":          "Note Stats",
  "version":       "1.0.0",
  "melon_api":     "1.0",
  "type":          "app_addon",
  "min_melon":     "0.6.0",
  "description":   "Shows real-time stats about your project: note count, pitch range, density, duration.",
  "author":        "MilkmanAbi",
  "license":       "MIT",
  "homepage":      "https://github.com/MilkmanAbi/Melon-Synth",
  "contributes": {
    "panels": [
      {
        "id":              "note_stats_panel",
        "display_name":    "Note Stats",
        "icon":            "BarChart2",
        "requested_zone":  "editor_bottom",
        "fallback_zone":   "right_sidebar",
        "component":       "NoteStatsPanel",
        "default_visible": true,
        "collapsible":     true,
        "resizable":       false
      }
    ]
  },
  "entry_point":  "index.js",
  "permissions":  ["project.read"]
}
